# PostgreSQL user for local Compose.
POSTGRES_USER=app
# PostgreSQL password for local Compose; use a local-only value.
POSTGRES_PASSWORD=app_secret
# PostgreSQL database name for local Compose.
POSTGRES_DB=app
# Browser API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side API base URL in Compose network.
API_ORIGIN=http://backend:8080
